# Reference bank API — copy to .env and customize before deployment
CHECKOUT_BANK_HOST=127.0.0.1
CHECKOUT_BANK_PORT=8090
CHECKOUT_BANK_DB=./data/checkout_bank.db
CHECKOUT_BANK_ADMIN_KEY=change-me-before-production
CHECKOUT_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CHECKOUT_RATE_LIMIT_VERIFY=120
CHECKOUT_BIND_PUBLIC=false

# Optional: forward each successful checkout (not presence) to the OSS Vercel counter.
# Leave empty in local tests so demo verifies do not inflate the public total.
# CHECKOUT_USAGE_STATS_URL=https://checkout-broadcast-stats.vercel.app
# CHECKOUT_USAGE_STATS_TOKEN=

# POS SDK
CHECKOUT_TERMINAL_ID=POS-LAG-001
CHECKOUT_SIGNING_KEY=
CHECKOUT_BANK_API_URL=http://127.0.0.1:8090
