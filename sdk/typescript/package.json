{
  "name": "@checkout-broadcast/web",
  "version": "1.4.4",
  "description": "Checkout Broadcast web SDK — receive signed POS payment broadcasts in banking apps",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "pack-check": "npm pack --dry-run"
  },
  "keywords": [
    "payments",
    "nigeria",
    "ble",
    "banking",
    "pos",
    "checkout"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/amithyone/checkout_broadcast.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/amithyone/checkout_broadcast/issues"
  },
  "homepage": "https://github.com/amithyone/checkout_broadcast#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/web-bluetooth": "^0.0.21",
    "typescript": "^5.4.0"
  }
}
